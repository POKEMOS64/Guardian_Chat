<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Вход</title>
    <style>
        body { font-family: sans-serif; background: #f0f2f5; display: flex; justify-content: center; align-items: center; height: 100vh; }
        form { background: white; padding: 30px; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.1); display: flex; flex-direction: column; gap: 10px; width: 300px; }
        input { padding: 10px; border: 1px solid #ccc; border-radius: 5px; }
        .error { color: red; text-align: center; margin-bottom: 10px; }
    </style>
</head>
<body>
    <form method="post">
        <h2 style="text-align: center;">Guardian Web</h2>
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <input type="text" name="username" placeholder="Имя пользователя" required>
        <input type="password" name="password" placeholder="Пароль" required>
        <button type="submit" name="action" value="login" style="padding: 10px; background: #0088cc; color: white; border: none; cursor: pointer;">Войти</button>
        <button type="submit" name="action" value="register" style="padding: 10px; background: #4caf50; color: white; border: none; cursor: pointer;">Регистрация</button>
    </form>
</body>
</html>
